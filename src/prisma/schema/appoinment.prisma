enum STATUS {
  pending
  confirmed
  cancelled
  completed
}

enum APPOINTMENT_TYPE {
  SERVICE
  RENT
}

// A date (and optional time range) the seller has blocked out — no bookings
// are accepted for that slot. `startTime`/`endTime` are HH:mm; when both are
// null the whole day is blocked.
model UnavailableSlot {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("SellerUnavailableSlots", fields: [sellerId], references: [id])
  date      String // YYYY-MM-DD
  startTime String? // HH:mm — null + null endTime = whole day blocked
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([sellerId, date])
}

model Appointment {
  id              String           @id @default(cuid())
  listingId       String
  listing         Listing          @relation(fields: [listingId], references: [id])
  buyerId         String
  buyer           User             @relation("BuyerAppointments", fields: [buyerId], references: [id])
  sellerId        String
  seller          User             @relation("SellerAppointments", fields: [sellerId], references: [id])
  bookingDate     String
  bookingTime     String?
  status          STATUS           @default(pending)
  appointmentType APPOINTMENT_TYPE @default(SERVICE)

  // Service-type fields
  price Float?

  // Rent-type fields
  hourlyPrice  Float?
  dailyPrice   Float?
  duration     Float?
  durationUnit String?

  @@unique([listingId, bookingDate, bookingTime, status])
}
