enum STATUS {
  pending
  confirmed
  cancelled
  completed
}

enum APPOINTMENT_TYPE {
  SERVICE
  RENT
}

model Appointment {
  id              String           @id @default(cuid())
  listingId       String
  listing         Listing          @relation(fields: [listingId], references: [id])
  buyerId         String
  sellerId        String
  bookingDate     String
  bookingTime     String?
  status          STATUS           @default(pending)
  appointmentType APPOINTMENT_TYPE @default(SERVICE)

  // Service-type fields
  price       Float? 

  // Rent-type fields
  hourlyPrice  Float?  
  dailyPrice   Float?  
  duration     Float?  
  durationUnit String?

  @@unique([listingId, bookingDate, bookingTime, status])
}
